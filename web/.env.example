# Color Hunter 웹 설정 (공개되어도 되는 값만. 비밀 값은 넣지 마세요)
# 로컬: 비워 두면 게임 서버를 "지금 연 주소:8787" 로 찾음 → 그냥 npm run dev:server + dev:web
# 배포(GitHub Pages)는 .github/workflows/pages.yml 이 아래 값을 자동으로 넣음

# 게임 서버(Cloudflare Worker) 주소
NEXT_PUBLIC_SERVER_URL=
# QR·참가 링크에 넣을 공개 주소. 비우면 브라우저의 현재 주소
NEXT_PUBLIC_SITE_URL=
# 하위 경로에 배포할 때만 (GitHub Pages 프로젝트 사이트면 /저장소이름)
NEXT_PUBLIC_BASE_PATH=
