{
  "name": "color-hunter",
  "version": "0.1.0",
  "private": true,
  "description": "스마트폰 카메라로 주변의 색을 찾아 찍는 팀전 파티 웹게임",
  "workspaces": [
    "shared",
    "server",
    "web"
  ],
  "scripts": {
    "dev:server": "npm -w server run dev",
    "dev:web": "npm -w web run dev",
    "build": "npm -w web run build",
    "test": "npm -w shared test",
    "test:server": "node --test tests/server.test.mjs",
    "test:e2e": "node tests/e2e.mjs",
    "typecheck": "npm -w shared run typecheck && npm -w server run typecheck && npm -w web run typecheck"
  },
  "devDependencies": {
    "playwright-core": "1.64.1",
    "typescript": "5.9.3"
  }
}
